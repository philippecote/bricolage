# Workshop configuration. Copy to .env — .env is gitignored.

PORT=4000

# Required for ctx.llm (the model primitive apps use) and the desktop agent.
OPENAI_API_KEY=

# The fast, cheap tier those two run on.
WORKSHOP_LLM_MODEL=gpt-5.6-luna
WORKSHOP_LLM_EFFORT=low

# Coding agent binaries. At least one must be installed and signed in.
CODEX_BIN=codex
CLAUDE_BIN=claude

# Relocates apps/, .workshop/, specs/ and actions/. The test suite sets this so a
# test run can never touch a running server's data.
# WORKSHOP_DATA_DIR=.workshop-test

# If set, API routes require this as a bearer token. Off by default: Workshop is
# local-first and expects to stay on localhost.
API_TOKEN=

# Only used by the legacy /render and /action routes.
OPENAI_MODEL=gpt-5.2-codex
