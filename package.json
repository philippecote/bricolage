{
  "name": "bricolage",
  "version": "1.0.0",
  "description": "A local-first desktop where you and a coding agent make small apps together, and then use them.",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k \"vite\" \"node --watch src/server.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "keywords": [
    "agents",
    "codex",
    "claude-code",
    "mcp",
    "local-first",
    "generative-ui"
  ],
  "author": "Phil Cote",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "openai": "^6.21.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
